{
	"$schema": "vscode://schemas/color-theme",
  "name": "Shikireki",
	"type": "light",


"tokenColors": [
  {
    "scope": ["keyword", "storage.type"],
    "settings": {"foreground": "#ffd700"}
  },
  {
    "scope": ["variable", "variable.parameter"],
    "settings": {"foreground": "#ffcc26"}
  },
  {
    "scope": ["constant", "entity.name.constant"],
    "settings": {"foreground": "#63ffd0"}
  },
  {
    "scope": ["string", "entity.name.tag"],
    "settings": {"foreground": "#ca1aff"}
  },
  {
    "scope": ["comment", "punctuation.definition.comment"],
    "settings": {"foreground": "#c93cb2", "fontStyle": "italic"}
  },
  {
    "scope": ["entity.name.function", "support.function"],
    "settings": {"foreground": "#f3ff07"}
  },
  {
    "scope": ["entity.name.class", "support.class"],
    "settings": {"foreground": "#ff00f7"}
  },
  {
    "scope": ["entity.other.attribute-name"],
    "settings": {"foreground": "#ffde25"}
  },
  {
    "scope": ["punctuation", "meta.brace"],
    "settings": {"foreground": "#ffffff"}
  },
  {
    "scope": ["invalid", "invalid.illegal"],
    "settings": {"foreground": "#ff0000"}
  },
  {
    "scope": ["meta.function-call"],
    "settings": {"foreground": "#4de13a"}
  },
  {
    "scope": ["meta.class", "meta.struct"],
    "settings": {"foreground": "#00ff04"}
  },
  {
    "scope": ["meta.tag", "declaration.tag"],
    "settings": {"foreground": "#ab3fbc"}
  },
  {
    "scope": ["meta.block", "punctuation.definition.block"],
    "settings": {"foreground": "#fddd25"}
  },
  {
    "scope": ["meta.annotation"],
    "settings": {"foreground": "#bee1ff"}
  },
  {
    "scope": ["entity.other.inherited-class"],
    "settings": {"foreground": "#d52eff"}
  },
  {
    "scope": ["constant.language", "support.constant"],
    "settings": {"foreground": "#ffff00"}
  },
  {
    "scope": ["storage.modifier"],
    "settings": {"foreground": "#908e0b"}
  }

],



